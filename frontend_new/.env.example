# Base URL of the CaseAssist backend.
# Leave empty ("VITE_API_BASE_URL=") to use the Vite dev proxy (/api -> http://localhost:8000).
VITE_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds (analysis can take a while).
VITE_API_TIMEOUT_MS=120000

# Set to "true" to run the UI with built-in sample data (no backend needed).
VITE_USE_MOCK=false

# Shape of the POST /api/analyze body: "both" (default), "query" or "legacy".
#   both   -> { query, caseId, title, problemDescription }
#   query  -> { query }
#   legacy -> { caseId, title, problemDescription }
VITE_ANALYZE_PAYLOAD=both

# Legal Mind AI chat endpoint. Leave empty to use the built-in DEMO replies.
# When set (for example /api/chat) the app POSTs { message, caseContext, history }
# and expects { reply } back. See src/api/chatService.js.
VITE_CHAT_ENDPOINT=
